generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model PaperBalance {
  asset     String   @id @db.VarChar(10)
  amount    Decimal  @db.Decimal(38, 18)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("paper_balances")
}

model PaperExecution {
  id                   String   @id @db.VarChar(100)
  symbol               String   @db.VarChar(20)
  side                 String   @db.VarChar(10)
  quantity             Decimal  @db.Decimal(38, 18)
  price                Decimal  @db.Decimal(38, 18)
  notional             Decimal  @db.Decimal(38, 18)
  feeRate              Decimal  @map("fee_rate") @db.Decimal(38, 18)
  fee                  Decimal  @db.Decimal(38, 18)
  totalCost            Decimal? @map("total_cost") @db.Decimal(38, 18)
  netProceeds          Decimal? @map("net_proceeds") @db.Decimal(38, 18)
  quotedAt             DateTime @map("quoted_at")
  marketDataReceivedAt DateTime @map("market_data_received_at")
  executedAt           DateTime @default(now()) @map("executed_at")

  @@map("paper_executions")
}

model RiskControlEvent {
  id        String   @id @db.VarChar(100)
  control   String   @db.VarChar(50)
  active    Boolean
  reason    String   @db.VarChar(200)
  changedAt DateTime @default(now()) @map("changed_at")

  @@index([control, changedAt, id])
  @@map("risk_control_events")
}

model StrategySignal {
  id                      String    @id @default(uuid()) @db.Uuid
  strategy                String    @db.VarChar(100)
  symbol                  String    @db.VarChar(20)
  action                  String    @db.VarChar(10)
  reason                  String    @db.VarChar(100)
  shortPeriod             Int       @map("short_period")
  longPeriod              Int       @map("long_period")
  previousShortAverage    Decimal?  @map("previous_short_average") @db.Decimal(65, 40)
  previousLongAverage     Decimal?  @map("previous_long_average") @db.Decimal(65, 40)
  currentShortAverage     Decimal?  @map("current_short_average") @db.Decimal(65, 40)
  currentLongAverage      Decimal?  @map("current_long_average") @db.Decimal(65, 40)
  latestCandleCloseTime   DateTime? @map("latest_candle_close_time")
  evaluatedAt             DateTime  @map("evaluated_at")

  @@unique([strategy, symbol, latestCandleCloseTime])
  @@index([evaluatedAt, id])
  @@map("strategy_signals")
}
