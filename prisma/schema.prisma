generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model PaperBalance {
  asset     String   @id @db.VarChar(10)
  amount    Decimal  @db.Decimal(38, 18)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("paper_balances")
}

model PaperExecution {
  id                   String   @id @db.VarChar(100)
  symbol               String   @db.VarChar(20)
  side                 String   @db.VarChar(10)
  quantity             Decimal  @db.Decimal(38, 18)
  price                Decimal  @db.Decimal(38, 18)
  notional             Decimal  @db.Decimal(38, 18)
  feeRate              Decimal  @map("fee_rate") @db.Decimal(38, 18)
  fee                  Decimal  @db.Decimal(38, 18)
  totalCost            Decimal? @map("total_cost") @db.Decimal(38, 18)
  netProceeds          Decimal? @map("net_proceeds") @db.Decimal(38, 18)
  quotedAt             DateTime @map("quoted_at")
  marketDataReceivedAt DateTime @map("market_data_received_at")
  executedAt           DateTime @default(now()) @map("executed_at")

  @@map("paper_executions")
}

model RiskControlEvent {
  id        String   @id @db.VarChar(100)
  control   String   @db.VarChar(50)
  active    Boolean
  reason    String   @db.VarChar(200)
  changedAt DateTime @default(now()) @map("changed_at")

  @@index([control, changedAt, id])
  @@map("risk_control_events")
}

model StrategySignal {
  id                    String    @id @default(uuid()) @db.Uuid
  strategy              String    @db.VarChar(100)
  symbol                String    @db.VarChar(20)
  action                String    @db.VarChar(10)
  reason                String    @db.VarChar(100)
  shortPeriod           Int       @map("short_period")
  longPeriod            Int       @map("long_period")
  previousShortAverage  Decimal?  @map("previous_short_average") @db.Decimal(65, 40)
  previousLongAverage   Decimal?  @map("previous_long_average") @db.Decimal(65, 40)
  currentShortAverage   Decimal?  @map("current_short_average") @db.Decimal(65, 40)
  currentLongAverage    Decimal?  @map("current_long_average") @db.Decimal(65, 40)
  latestCandleCloseTime DateTime? @map("latest_candle_close_time")
  evaluatedAt           DateTime  @map("evaluated_at")

  @@unique([strategy, symbol, latestCandleCloseTime])
  @@index([evaluatedAt, id])
  @@map("strategy_signals")
}

model HistoricalCandleRecord {
  symbol              String   @db.VarChar(20)
  interval            String   @db.VarChar(10)
  openTime            DateTime @map("open_time")
  closeTime           DateTime @map("close_time")
  openPrice           String   @map("open_price") @db.Text
  highPrice           String   @map("high_price") @db.Text
  lowPrice            String   @map("low_price") @db.Text
  closePrice          String   @map("close_price") @db.Text
  baseVolume          String   @map("base_volume") @db.Text
  quoteVolume         String   @map("quote_volume") @db.Text
  takerBuyBaseVolume  String   @map("taker_buy_base_volume") @db.Text
  takerBuyQuoteVolume String   @map("taker_buy_quote_volume") @db.Text
  tradeCount          BigInt   @map("trade_count")
  isClosed            Boolean  @map("is_closed")
  createdAt           DateTime @default(now()) @map("created_at")

  @@id([symbol, interval, openTime])
  @@map("historical_candles")
}

model BacktestRun {
  id                 String   @id @default(uuid()) @db.Uuid
  idempotencyKey     String   @unique @map("idempotency_key") @db.VarChar(100)
  requestFingerprint String   @map("request_fingerprint") @db.Char(64)
  request            Json
  result             Json
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([createdAt, id])
  @@map("backtest_runs")
}

model AgenticWalletFundingConversionPlan {
  id                          String                                           @id @db.Uuid
  fingerprint                 String                                           @unique @db.Char(64)
  confirmationPhraseDigest    String                                           @map("confirmation_phrase_digest") @db.Char(64)
  providerId                  String                                           @map("provider_id") @db.VarChar(32)
  chainId                     String                                           @map("chain_id") @db.VarChar(32)
  sourceTokenAddress          String                                           @map("source_token_address") @db.VarChar(42)
  targetTokenAddress          String                                           @map("target_token_address") @db.VarChar(42)
  sourceQuantityBnb           String                                           @map("source_quantity_bnb") @db.Text
  expectedUsdt                String                                           @map("expected_usdt") @db.Text
  minimumUsdt                 String                                           @map("minimum_usdt") @db.Text
  maximumSlippagePercent      String                                           @map("maximum_slippage_percent") @db.Text
  remainingQuantityBnb        String                                           @map("remaining_quantity_bnb") @db.Text
  minimumGasReserveBnb        String?                                          @map("minimum_gas_reserve_bnb") @db.Text
  mevProtection               Boolean                                          @map("mev_protection")
  gasLevel                    String                                           @map("gas_level") @db.VarChar(16)
  costCoverage                String                                           @map("cost_coverage") @db.VarChar(16)
  gasReserveSufficiency       String                                           @map("gas_reserve_sufficiency") @db.VarChar(16)
  activationBlockers          Json                                             @map("activation_blockers")
  executionConfigurationReady Boolean                                          @map("execution_configuration_ready")
  quotedAt                    DateTime                                         @map("quoted_at")
  quoteExpiresAt              DateTime                                         @map("quote_expires_at")
  confirmationExpiresAt       DateTime                                         @map("confirmation_expires_at")
  preparedAt                  DateTime                                         @map("prepared_at")
  submissionAttempt           AgenticWalletFundingConversionSubmissionAttempt?

  @@index([preparedAt, id])
  @@map("agentic_wallet_funding_conversion_plans")
}

model AgenticWalletFundingConversionSubmissionAttempt {
  id                          String                                            @id @db.Uuid
  planId                      String                                            @unique @map("plan_id") @db.Uuid
  requestFingerprint          String                                            @map("request_fingerprint") @db.Char(64)
  freshSourceQuantityBnb      String                                            @map("fresh_source_quantity_bnb") @db.Text
  freshExpectedUsdt           String                                            @map("fresh_expected_usdt") @db.Text
  freshMinimumUsdt            String                                            @map("fresh_minimum_usdt") @db.Text
  freshMaximumSlippagePercent String                                            @map("fresh_maximum_slippage_percent") @db.Text
  freshRemainingQuantityBnb   String                                            @map("fresh_remaining_quantity_bnb") @db.Text
  state                       String                                            @db.VarChar(40)
  providerOrderId             String?                                           @unique @map("provider_order_id") @db.VarChar(256)
  responseFingerprint         String?                                           @map("response_fingerprint") @db.Char(64)
  automaticRetryAllowed       Boolean                                           @map("automatic_retry_allowed")
  startedAt                   DateTime                                          @map("started_at")
  completedAt                 DateTime?                                         @map("completed_at")
  plan                        AgenticWalletFundingConversionPlan                @relation(fields: [planId], references: [id], onDelete: Restrict)
  statusObservations          AgenticWalletFundingConversionStatusObservation[]

  @@index([state, startedAt])
  @@map("agentic_wallet_funding_conversion_submission_attempts")
}

model AgenticWalletFundingConversionStatusObservation {
  id                String                                          @id @db.Uuid
  attemptId         String                                          @map("attempt_id") @db.Uuid
  providerOrderId   String                                          @map("provider_order_id") @db.VarChar(256)
  providerStatus    String                                          @map("provider_status") @db.VarChar(16)
  transactionHash   String?                                         @unique(map: "funding_conversion_status_tx_hash_key") @map("transaction_hash") @db.VarChar(66)
  bookedAt          DateTime                                        @map("booked_at")
  providerUpdatedAt DateTime                                        @map("provider_updated_at")
  recordedAt        DateTime                                        @map("recorded_at")
  attempt           AgenticWalletFundingConversionSubmissionAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@unique([attemptId, providerUpdatedAt], map: "funding_conversion_status_attempt_updated_key")
  @@index([attemptId, recordedAt], map: "funding_conversion_status_attempt_recorded_idx")
  @@map("agentic_wallet_funding_conversion_status_observations")
}

model RealExecutionReservation {
  id                       String                     @id @default(uuid()) @db.Uuid
  providerId               String                     @map("provider_id") @db.VarChar(32)
  chainId                  String                     @map("chain_id") @db.VarChar(32)
  intentId                 String                     @unique @map("intent_id") @db.Uuid
  quoteId                  String                     @unique @map("quote_id") @db.Uuid
  idempotencyKey           String                     @unique @map("idempotency_key") @db.VarChar(128)
  requestFingerprint       String                     @map("request_fingerprint") @db.Char(64)
  payloadCommitmentVersion String?                    @map("payload_commitment_version") @db.VarChar(64)
  payloadCommitmentDigest  String?                    @map("payload_commitment_digest") @db.Char(64)
  utcDay                   DateTime                   @map("utc_day") @db.Date
  budgetChargeUsdt         String                     @map("budget_charge_usdt") @db.Text
  sourceTokenAddress       String                     @map("source_token_address") @db.VarChar(256)
  sourceSymbol             String                     @map("source_symbol") @db.VarChar(32)
  sourceQuantity           String                     @map("source_quantity") @db.Text
  nativeGasSymbol          String                     @map("native_gas_symbol") @db.VarChar(32)
  nativeGasQuantity        String                     @map("native_gas_quantity") @db.Text
  providerQuotaUsd         String                     @map("provider_quota_usd") @db.Text
  expiresAt                DateTime                   @map("expires_at")
  createdAt                DateTime                   @default(now()) @map("created_at")
  arm                      RealExecutionArm?
  riskApproval             RealExecutionRiskApproval?

  @@index([providerId, chainId, utcDay, expiresAt])
  @@map("real_execution_reservations")
}

model RealExecutionArm {
  id                       String                     @id @db.Uuid
  reservationId            String                     @unique @map("reservation_id") @db.Uuid
  providerId               String                     @map("provider_id") @db.VarChar(32)
  chainId                  String                     @map("chain_id") @db.VarChar(32)
  intentId                 String                     @unique @map("intent_id") @db.Uuid
  quoteId                  String                     @unique @map("quote_id") @db.Uuid
  payloadCommitmentVersion String?                    @map("payload_commitment_version") @db.VarChar(64)
  payloadCommitmentDigest  String?                    @map("payload_commitment_digest") @db.Char(64)
  acknowledgment           String                     @db.VarChar(64)
  requestFingerprint       String                     @map("request_fingerprint") @db.Char(64)
  requestedAt              DateTime                   @map("requested_at")
  expiresAt                DateTime                   @map("expires_at")
  createdAt                DateTime                   @default(now()) @map("created_at")
  reservation              RealExecutionReservation   @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  riskApproval             RealExecutionRiskApproval?

  @@index([providerId, chainId, expiresAt])
  @@map("real_execution_arms")
}

model RealExecutionRiskApproval {
  id                       String                          @id @db.Uuid
  reservationId            String                          @unique @map("reservation_id") @db.Uuid
  armId                    String                          @unique @map("arm_id") @db.Uuid
  providerId               String                          @map("provider_id") @db.VarChar(32)
  chainId                  String                          @map("chain_id") @db.VarChar(32)
  intentId                 String                          @unique @map("intent_id") @db.Uuid
  quoteId                  String                          @unique @map("quote_id") @db.Uuid
  payloadCommitmentVersion String?                         @map("payload_commitment_version") @db.VarChar(64)
  payloadCommitmentDigest  String?                         @map("payload_commitment_digest") @db.Char(64)
  emergencyStopChangeId    String                          @map("emergency_stop_change_id") @db.VarChar(100)
  requestFingerprint       String                          @map("request_fingerprint") @db.Char(64)
  revalidatedAt            DateTime                        @map("revalidated_at")
  expiresAt                DateTime                        @map("expires_at")
  createdAt                DateTime                        @default(now()) @map("created_at")
  reservation              RealExecutionReservation        @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  arm                      RealExecutionArm                @relation(fields: [armId], references: [id], onDelete: Restrict)
  finalConfirmation        RealExecutionFinalConfirmation?

  @@index([providerId, chainId, expiresAt])
  @@map("real_execution_risk_approvals")
}

model RealExecutionFinalConfirmation {
  id                       String                       @id @db.Uuid
  approvalId               String                       @unique @map("approval_id") @db.Uuid
  reservationId            String                       @unique @map("reservation_id") @db.Uuid
  armId                    String                       @unique @map("arm_id") @db.Uuid
  providerId               String                       @map("provider_id") @db.VarChar(32)
  chainId                  String                       @map("chain_id") @db.VarChar(32)
  intentId                 String                       @unique @map("intent_id") @db.Uuid
  quoteId                  String                       @unique @map("quote_id") @db.Uuid
  payloadCommitmentVersion String?                      @map("payload_commitment_version") @db.VarChar(64)
  payloadCommitmentDigest  String?                      @map("payload_commitment_digest") @db.Char(64)
  emergencyStopChangeId    String                       @map("emergency_stop_change_id") @db.VarChar(100)
  acknowledgment           String                       @db.VarChar(100)
  requestFingerprint       String                       @map("request_fingerprint") @db.Char(64)
  requestedAt              DateTime                     @map("requested_at")
  expiresAt                DateTime                     @map("expires_at")
  createdAt                DateTime                     @default(now()) @map("created_at")
  approval                 RealExecutionRiskApproval    @relation(fields: [approvalId], references: [id], onDelete: Restrict)
  submissionGate           RealExecutionSubmissionGate?

  @@index([providerId, chainId, expiresAt])
  @@map("real_execution_final_confirmations")
}

model RealExecutionSubmissionGate {
  id                              String                                        @id @db.Uuid
  confirmationId                  String                                        @unique @map("confirmation_id") @db.Uuid
  approvalId                      String                                        @unique @map("approval_id") @db.Uuid
  reservationId                   String                                        @unique @map("reservation_id") @db.Uuid
  armId                           String                                        @unique @map("arm_id") @db.Uuid
  submissionPlanId                String                                        @unique @map("submission_plan_id") @db.Uuid
  providerId                      String                                        @map("provider_id") @db.VarChar(32)
  chainId                         String                                        @map("chain_id") @db.VarChar(32)
  intentId                        String                                        @unique @map("intent_id") @db.Uuid
  quoteId                         String                                        @unique @map("quote_id") @db.Uuid
  payloadCommitmentVersion        String                                        @map("payload_commitment_version") @db.VarChar(64)
  payloadCommitmentDigest         String                                        @map("payload_commitment_digest") @db.Char(64)
  emergencyStopChangeId           String                                        @map("emergency_stop_change_id") @db.VarChar(100)
  sourceTokenAddress              String                                        @map("source_token_address") @db.VarChar(256)
  targetTokenAddress              String                                        @map("target_token_address") @db.VarChar(256)
  sourceQuantity                  String                                        @map("source_quantity") @db.Text
  maximumSlippagePercent          String                                        @map("maximum_slippage_percent") @db.Text
  mevProtection                   Boolean                                       @map("mev_protection")
  gasLevel                        String                                        @map("gas_level") @db.VarChar(16)
  status                          String                                        @db.VarChar(40)
  requestFingerprint              String                                        @map("request_fingerprint") @db.Char(64)
  emergencyStopRecheckedAt        DateTime                                      @map("emergency_stop_rechecked_at")
  confirmationConsumedAt          DateTime                                      @map("confirmation_consumed_at")
  expiresAt                       DateTime?                                     @map("expires_at")
  createdAt                       DateTime                                      @default(now()) @map("created_at")
  confirmation                    RealExecutionFinalConfirmation                @relation(fields: [confirmationId], references: [id], onDelete: Restrict)
  submissionReceipt               RealExecutionSubmissionReceipt?
  financialReconciliationEvidence RealExecutionFinancialReconciliationEvidence?

  @@index([providerId, chainId, createdAt])
  @@map("real_execution_submission_gates")
}

model RealExecutionSubmissionReceipt {
  gateId                         String                           @id @map("gate_id") @db.Uuid
  providerId                     String                           @map("provider_id") @db.VarChar(32)
  providerOrderId                String                           @unique @map("provider_order_id") @db.VarChar(256)
  lifecycleStatus                String                           @map("lifecycle_status") @db.VarChar(32)
  providerSubmissionAcknowledged Boolean                          @map("provider_submission_acknowledged")
  terminal                       Boolean
  executionSucceeded             Boolean                          @map("execution_succeeded")
  statusLookupRequired           Boolean                          @map("status_lookup_required")
  automaticRetryAllowed          Boolean                          @map("automatic_retry_allowed")
  recordedAt                     DateTime                         @default(now()) @map("recorded_at")
  gate                           RealExecutionSubmissionGate      @relation(fields: [gateId], references: [id], onDelete: Restrict)
  statusObservations             RealExecutionStatusObservation[]

  @@unique([gateId, providerId, providerOrderId])
  @@index([providerId, lifecycleStatus, recordedAt])
  @@map("real_execution_submission_receipts")
}

model RealExecutionStatusObservation {
  id                              String                                        @id @db.Uuid
  sequence                        BigInt                                        @unique @default(autoincrement())
  gateId                          String                                        @map("gate_id") @db.Uuid
  providerId                      String                                        @map("provider_id") @db.VarChar(32)
  providerOrderId                 String                                        @map("provider_order_id") @db.VarChar(256)
  providerStatus                  String                                        @map("provider_status") @db.VarChar(16)
  transactionHash                 String?                                       @map("transaction_hash") @db.VarChar(66)
  bookedAt                        DateTime                                      @map("booked_at")
  providerUpdatedAt               DateTime                                      @map("provider_updated_at")
  recordedAt                      DateTime                                      @default(now()) @map("recorded_at")
  submissionReceipt               RealExecutionSubmissionReceipt                @relation(fields: [gateId, providerId, providerOrderId], references: [gateId, providerId, providerOrderId], onDelete: Restrict)
  financialReconciliationEvidence RealExecutionFinancialReconciliationEvidence?

  @@index([gateId, sequence])
  @@index([providerId, providerStatus, recordedAt])
  @@map("real_execution_status_observations")
}

model RealExecutionFinancialReconciliationEvidence {
  id                           String                                     @id @db.Uuid
  gateId                       String                                     @unique @map("gate_id") @db.Uuid
  statusObservationId          String                                     @unique @map("status_observation_id") @db.Uuid
  providerId                   String                                     @map("provider_id") @db.VarChar(32)
  providerOrderId              String                                     @unique @map("provider_order_id") @db.VarChar(256)
  chainId                      String                                     @map("chain_id") @db.VarChar(32)
  transactionHash              String                                     @unique @map("transaction_hash") @db.VarChar(66)
  sourceTokenAddress           String                                     @map("source_token_address") @db.VarChar(256)
  targetTokenAddress           String                                     @map("target_token_address") @db.VarChar(256)
  submittedSourceQuantity      String                                     @map("submitted_source_quantity") @db.Text
  actualTargetReceivedQuantity String                                     @map("actual_target_received_quantity") @db.Text
  providerFeeComponents        Json                                       @map("provider_fee_components")
  networkFeeAsset              String                                     @map("network_fee_asset") @db.VarChar(16)
  networkFeeQuantity           String                                     @map("network_fee_quantity") @db.Text
  requestFingerprint           String                                     @map("request_fingerprint") @db.Char(64)
  observedAt                   DateTime                                   @map("observed_at")
  recordedAt                   DateTime                                   @default(now()) @map("recorded_at")
  gate                         RealExecutionSubmissionGate                @relation(fields: [gateId], references: [id], onDelete: Restrict)
  statusObservation            RealExecutionStatusObservation             @relation(fields: [statusObservationId], references: [id], onDelete: Restrict)
  accountingBalanceEvidence    RealExecutionAccountingBalanceEvidence?
  accountingMutationCommitment RealExecutionAccountingMutationCommitment?

  @@index([providerId, recordedAt])
  @@map("real_execution_financial_reconciliation_evidence")
}

model RealExecutionAccountingBalanceEvidence {
  id                                String                                       @id @db.Uuid
  financialReconciliationEvidenceId String                                       @unique @map("financial_reconciliation_evidence_id") @db.Uuid
  gateId                            String                                       @unique @map("gate_id") @db.Uuid
  transactionHash                   String                                       @unique @map("transaction_hash") @db.VarChar(66)
  balanceChanges                    Json                                         @map("balance_changes")
  requestFingerprint                String                                       @map("request_fingerprint") @db.Char(64)
  observedAt                        DateTime                                     @map("observed_at")
  recordedAt                        DateTime                                     @default(now()) @map("recorded_at")
  financialReconciliationEvidence   RealExecutionFinancialReconciliationEvidence @relation(fields: [financialReconciliationEvidenceId], references: [id], onDelete: Restrict)
  accountingMutationCommitment      RealExecutionAccountingMutationCommitment?

  @@index([recordedAt])
  @@map("real_execution_accounting_balance_evidence")
}

model RealExecutionAccountingMutationCommitment {
  id                                String                                        @id @db.Uuid
  accountingBalanceEvidenceId       String                                        @unique @map("accounting_balance_evidence_id") @db.Uuid
  financialReconciliationEvidenceId String                                        @unique @map("financial_reconciliation_evidence_id") @db.Uuid
  gateId                            String                                        @unique @map("gate_id") @db.Uuid
  transactionHash                   String                                        @unique @map("transaction_hash") @db.VarChar(66)
  planFingerprint                   String                                        @unique @map("plan_fingerprint") @db.Char(64)
  balanceTransitions                Json                                          @map("balance_transitions")
  evidenceObservedAt                DateTime                                      @map("evidence_observed_at")
  evidenceRecordedAt                DateTime                                      @map("evidence_recorded_at")
  preparedAt                        DateTime                                      @map("prepared_at")
  requestFingerprint                String                                        @map("request_fingerprint") @db.Char(64)
  recordedAt                        DateTime                                      @default(now()) @map("recorded_at")
  accountingBalanceEvidence         RealExecutionAccountingBalanceEvidence        @relation(fields: [accountingBalanceEvidenceId], references: [id], onDelete: Restrict)
  financialReconciliationEvidence   RealExecutionFinancialReconciliationEvidence  @relation(fields: [financialReconciliationEvidenceId], references: [id], onDelete: Restrict)
  accountingMutationAuthorization   RealExecutionAccountingMutationAuthorization?

  @@index([recordedAt])
  @@map("real_execution_accounting_mutation_commitments")
}

model RealExecutionAccountingMutationAuthorization {
  id                                String                                      @id @db.Uuid
  accountingMutationCommitmentId    String                                      @unique(map: "real_exec_acct_auth_commitment_key") @map("accounting_mutation_commitment_id") @db.Uuid
  accountingBalanceEvidenceId       String                                      @unique(map: "real_exec_acct_auth_balance_key") @map("accounting_balance_evidence_id") @db.Uuid
  financialReconciliationEvidenceId String                                      @unique(map: "real_exec_acct_auth_financial_key") @map("financial_reconciliation_evidence_id") @db.Uuid
  gateId                            String                                      @unique(map: "real_exec_acct_auth_gate_key") @map("gate_id") @db.Uuid
  transactionHash                   String                                      @unique(map: "real_exec_acct_auth_tx_key") @map("transaction_hash") @db.VarChar(66)
  planFingerprint                   String                                      @unique(map: "real_exec_acct_auth_plan_key") @map("plan_fingerprint") @db.Char(64)
  acknowledgment                    String                                      @map("acknowledgment") @db.VarChar(96)
  authorizedAt                      DateTime                                    @map("authorized_at")
  requestFingerprint                String                                      @map("request_fingerprint") @db.Char(64)
  recordedAt                        DateTime                                    @default(now()) @map("recorded_at")
  accountingMutationCommitment      RealExecutionAccountingMutationCommitment   @relation(fields: [accountingMutationCommitmentId], references: [id], onDelete: Restrict)
  accountingMutationApplication     RealExecutionAccountingMutationApplication?

  @@index([recordedAt], map: "real_exec_acct_auth_recorded_at_idx")
  @@map("real_execution_accounting_mutation_authorizations")
}

model RealExecutionAccountingBalance {
  assetIdentity String   @id @map("asset_identity") @db.VarChar(64)
  assetType     String   @map("asset_type") @db.VarChar(16)
  assetAddress  String?  @map("asset_address") @db.VarChar(42)
  assetSymbol   String?  @map("asset_symbol") @db.VarChar(16)
  quantity      String   @db.Text
  updatedAt     DateTime @map("updated_at")

  @@map("real_execution_accounting_balances")
}

model RealExecutionAccountingBalanceInitialization {
  id                      String                                        @id @db.Uuid
  providerId              String                                        @map("provider_id") @db.VarChar(32)
  chainId                 String                                        @map("chain_id") @db.VarChar(32)
  acknowledgment          String                                        @db.VarChar(96)
  balances                Json
  walletObservedAt        DateTime                                      @map("wallet_observed_at")
  maximumObservationAgeMs Int                                           @map("maximum_observation_age_ms")
  preparedAt              DateTime                                      @map("prepared_at")
  requestFingerprint      String                                        @map("request_fingerprint") @db.Char(64)
  initializedAt           DateTime                                      @map("initialized_at")
  ledgerReconciliations   RealExecutionAccountingLedgerReconciliation[]

  @@unique([providerId, chainId], map: "real_exec_acct_init_provider_chain_key")
  @@index([initializedAt], map: "real_exec_acct_init_initialized_at_idx")
  @@map("real_execution_accounting_balance_initializations")
}

model RealExecutionAccountingLedgerReconciliation {
  id                        String                                       @id @db.Uuid
  initializationId          String                                       @map("initialization_id") @db.Uuid
  providerId                String                                       @map("provider_id") @db.VarChar(32)
  chainId                   String                                       @map("chain_id") @db.VarChar(32)
  reconciliationFingerprint String                                       @unique(map: "real_exec_acct_recon_fingerprint_key") @map("reconciliation_fingerprint") @db.Char(64)
  initialBalances           Json                                         @map("initial_balances")
  currentBalances           Json                                         @map("current_balances")
  initializedAt             DateTime                                     @map("initialized_at")
  evaluatedAt               DateTime                                     @map("evaluated_at")
  walletBalances            Json                                         @map("wallet_balances")
  walletObservedAt          DateTime                                     @map("wallet_observed_at")
  reconciledAt              DateTime                                     @map("reconciled_at")
  preparedAt                DateTime                                     @map("prepared_at")
  requestFingerprint        String                                       @map("request_fingerprint") @db.Char(64)
  recordedAt                DateTime                                     @map("recorded_at")
  initialization            RealExecutionAccountingBalanceInitialization @relation(fields: [initializationId], references: [id], onDelete: Restrict)

  @@index([initializationId, recordedAt], map: "real_exec_acct_recon_init_recorded_idx")
  @@map("real_execution_accounting_ledger_reconciliations")
}

model RealExecutionAccountingMutationApplication {
  id                                String                                       @id @db.Uuid
  authorizationId                   String                                       @unique(map: "real_exec_acct_app_authorization_key") @map("authorization_id") @db.Uuid
  accountingMutationCommitmentId    String                                       @unique(map: "real_exec_acct_app_commitment_key") @map("accounting_mutation_commitment_id") @db.Uuid
  accountingBalanceEvidenceId       String                                       @unique(map: "real_exec_acct_app_balance_key") @map("accounting_balance_evidence_id") @db.Uuid
  financialReconciliationEvidenceId String                                       @unique(map: "real_exec_acct_app_financial_key") @map("financial_reconciliation_evidence_id") @db.Uuid
  gateId                            String                                       @unique(map: "real_exec_acct_app_gate_key") @map("gate_id") @db.Uuid
  transactionHash                   String                                       @unique(map: "real_exec_acct_app_tx_key") @map("transaction_hash") @db.VarChar(66)
  planFingerprint                   String                                       @unique(map: "real_exec_acct_app_plan_key") @map("plan_fingerprint") @db.Char(64)
  acknowledgment                    String                                       @map("acknowledgment") @db.VarChar(96)
  currentBalances                   Json                                         @map("current_balances")
  balanceTransitions                Json                                         @map("balance_transitions")
  authorizationRecordedAt           DateTime                                     @map("authorization_recorded_at")
  balancesObservedAt                DateTime                                     @map("balances_observed_at")
  preparedAt                        DateTime                                     @map("prepared_at")
  requestFingerprint                String                                       @map("request_fingerprint") @db.Char(64)
  appliedAt                         DateTime                                     @map("applied_at")
  accountingMutationAuthorization   RealExecutionAccountingMutationAuthorization @relation(fields: [authorizationId], references: [id], onDelete: Restrict)

  @@index([appliedAt], map: "real_exec_acct_app_applied_at_idx")
  @@map("real_execution_accounting_mutation_applications")
}

model ObservedSpotSymbol {
  provider               String                         @db.VarChar(30)
  symbol                 String                         @db.VarChar(30)
  baseAsset              String                         @map("base_asset") @db.VarChar(20)
  quoteAsset             String                         @map("quote_asset") @db.VarChar(20)
  status                 String                         @db.VarChar(30)
  spotTradingAllowed     Boolean                        @map("spot_trading_allowed")
  firstObservedAt        DateTime                       @map("first_observed_at")
  lastObservedAt         DateTime                       @map("last_observed_at")
  detectedAt             DateTime?                      @map("detected_at")
  observationCheckpoints ListingObservationCheckpoint[]

  @@id([provider, symbol])
  @@index([firstObservedAt, provider, symbol])
  @@index([detectedAt, provider, symbol])
  @@map("observed_spot_symbols")
}

model ListingObservationCheckpoint {
  provider        String                      @db.VarChar(30)
  symbol          String                      @db.VarChar(30)
  label           String                      @db.VarChar(10)
  offsetMs        Int                         @map("offset_ms")
  targetAt        DateTime                    @map("target_at")
  claimToken      String?                     @map("claim_token") @db.VarChar(100)
  claimedAt       DateTime?                   @map("claimed_at")
  claimExpiresAt  DateTime?                   @map("claim_expires_at")
  completedAt     DateTime?                   @map("completed_at")
  lastPrice       Decimal?                    @map("last_price") @db.Decimal(38, 18)
  baseVolume      Decimal?                    @map("base_volume") @db.Decimal(38, 18)
  quoteVolume     Decimal?                    @map("quote_volume") @db.Decimal(38, 18)
  tradeCount      BigInt?                     @map("trade_count")
  windowOpenTime  DateTime?                   @map("window_open_time")
  windowCloseTime DateTime?                   @map("window_close_time")
  receivedAt      DateTime?                   @map("received_at")
  createdAt       DateTime                    @default(now()) @map("created_at")
  detection       ObservedSpotSymbol          @relation(fields: [provider, symbol], references: [provider, symbol], onDelete: Cascade)
  topOfBook       ListingCheckpointTopOfBook?

  @@id([provider, symbol, label])
  @@index([targetAt, provider, symbol, label])
  @@index([claimExpiresAt, targetAt, provider, symbol, label])
  @@map("listing_observation_checkpoints")
}

model ListingCheckpointTopOfBook {
  provider    String                       @db.VarChar(30)
  symbol      String                       @db.VarChar(30)
  label       String                       @db.VarChar(10)
  updateId    String                       @map("update_id") @db.Text
  bidPrice    String                       @map("bid_price") @db.Text
  bidQuantity String                       @map("bid_quantity") @db.Text
  askPrice    String                       @map("ask_price") @db.Text
  askQuantity String                       @map("ask_quantity") @db.Text
  receivedAt  DateTime                     @map("received_at")
  createdAt   DateTime                     @default(now()) @map("created_at")
  checkpoint  ListingObservationCheckpoint @relation(fields: [provider, symbol, label], references: [provider, symbol, label], onDelete: Cascade)

  @@id([provider, symbol, label])
  @@map("listing_checkpoint_top_of_books")
}
